# Backend (Express) — copy to .env and fill in real values

# Supabase (from Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# ⚠️ Service role key — NEVER commit, NEVER expose to client.
#    Bypasses Row Level Security. Treat like a master password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server port (Render auto-assigns in production via $PORT)
PORT=3001
